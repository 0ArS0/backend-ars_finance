generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountKind {
  checking
  savings
  cash
  credit_card
  investment
  wallet
}

enum LegalContext {
  pf
  pj
}

enum TransactionDirection {
  inflow
  outflow
}

enum PaymentMethod {
  debit
  credit
  cash
  pix
  transfer
  boleto
  investment
}

enum IncomeKind {
  salary
  reimbursement
  gift
  bonus
  freelance
  other
}

enum CategoryKind {
  expense
  income
  transfer
}

enum BudgetType {
  fixed
  variable
  discretionary
}

enum RecurrenceFrequency {
  daily
  weekly
  monthly
  yearly
}

enum InvestmentTransactionType {
  buy
  sell
  dividend
  contribution
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions           Session[]
  financialAccounts  FinancialAccount[]
  categories         Category[]
  payees             Payee[]
  beneficiaries      Beneficiary[]
  importRules        ImportMappingRule[]
  goals              Goal[]
  investmentAccounts InvestmentAccount[]
  appSettings        AppSetting[]
  pluggyConnections  PluggyConnection[]
}

model PluggyConnection {
  id            String        @id @default(uuid())
  userId        String
  itemId        String
  label         String?
  legalContext  LegalContext  @default(pf)
  lastUpdatedAt DateTime?
  createdAt     DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@index([userId])
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model FinancialAccount {
  id             String       @id @default(uuid())
  userId         String?
  externalId     String?      @unique
  name           String
  kind           AccountKind
  legalContext   LegalContext
  currency       String       @default("BRL")
  openingBalance Decimal      @default(0) @db.Decimal(12, 2)
  currentBalance Decimal?     @db.Decimal(12, 2)
  isActive       Boolean      @default(true)
  creditLimit    Decimal?     @db.Decimal(12, 2)
  closingDay     Int?
  dueDay         Int?
  createdAt      DateTime     @default(now())

  transactions Transaction[]
  statements   CreditCardStatement[]
  recurringRules RecurringRule[]
  importRules  ImportMappingRule[]
  user         User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AppSetting {
  id            Int      @id @default(autoincrement())
  userId        String?  @unique
  monthlyIncome Decimal? @db.Decimal(12, 2)
  updatedAt     DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id         String      @id @default(uuid())
  userId     String?
  name       String
  parentId   String?
  kind       CategoryKind
  budgetType BudgetType?
  createdAt  DateTime    @default(now())

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  transactions Transaction[]
  recurringRules RecurringRule[]
  importRules ImportMappingRule[]
  user       User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Payee {
  id        String   @id @default(uuid())
  userId    String?
  name      String
  type      String?
  createdAt DateTime @default(now())

  transactions Transaction[]
  user         User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum ImportMatchType {
  regex
  contains
  starts_with
  document
}

model ImportMappingRule {
  id              String           @id @default(uuid())
  userId          String?
  label           String
  pattern         String
  matchType       ImportMatchType  @default(contains)
  beneficiaryId   String?
  categoryId      String?
  targetAccountId String?
  incomeKind      IncomeKind?
  skip            Boolean          @default(false)
  priority        Int              @default(0)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())

  beneficiary   Beneficiary?      @relation(fields: [beneficiaryId], references: [id])
  category      Category?         @relation(fields: [categoryId], references: [id])
  targetAccount FinancialAccount? @relation(fields: [targetAccountId], references: [id])
  user          User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Beneficiary {
  id        String   @id @default(uuid())
  userId    String?
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  transactions Transaction[]
  recurringRules RecurringRule[]
  importRules ImportMappingRule[]
  user       User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CreditCardStatement {
  id             String   @id @default(uuid())
  accountId      String
  referenceMonth DateTime @db.Date
  closingDate    DateTime @db.Date
  dueDate        DateTime @db.Date
  totalAmount    Decimal  @default(0) @db.Decimal(12, 2)
  paidAmount     Decimal  @default(0) @db.Decimal(12, 2)
  isExternalTotal Boolean @default(false)
  isPaid         Boolean  @default(false)
  createdAt      DateTime @default(now())

  account      FinancialAccount @relation(fields: [accountId], references: [id])
  transactions Transaction[]

  @@index([accountId, referenceMonth])
}

model RecurringRule {
  id            String              @id @default(uuid())
  accountId     String
  direction     TransactionDirection
  amount        Decimal             @db.Decimal(12, 2)
  description   String
  frequency     RecurrenceFrequency
  dayOfMonth    Int?
  startDate     DateTime            @db.Date
  endDate       DateTime?           @db.Date
  budgetType    BudgetType          @default(variable)
  categoryId    String?
  beneficiaryId String?
  createdAt     DateTime            @default(now())

  account     FinancialAccount @relation(fields: [accountId], references: [id])
  category    Category?        @relation(fields: [categoryId], references: [id])
  beneficiary Beneficiary?     @relation(fields: [beneficiaryId], references: [id])
  transactions Transaction[]
}

model Transaction {
  id              String               @id @default(uuid())
  accountId       String
  direction       TransactionDirection
  paymentMethod   PaymentMethod
  amount          Decimal              @db.Decimal(12, 2)
  description     String               @db.VarChar(120)
  notes           String?
  transactionDate DateTime             @db.Date
  postedDate      DateTime?            @db.Date
  dueDate         DateTime?            @db.Date
  incomeKind      IncomeKind?
  categoryId      String?
  payeeId         String?
  beneficiaryId   String?
  isRecurring     Boolean              @default(false)
  recurringRuleId String?
  installmentN    Int?
  installmentTotal Int?
  parentId        String?
  reimbursementOfId String?
  statementId     String?
  externalId      String?              @unique
  createdAt       DateTime             @default(now())

  account       FinancialAccount      @relation(fields: [accountId], references: [id])
  category      Category?             @relation(fields: [categoryId], references: [id])
  payee         Payee?                @relation(fields: [payeeId], references: [id])
  beneficiary   Beneficiary?          @relation(fields: [beneficiaryId], references: [id])
  recurringRule RecurringRule?        @relation(fields: [recurringRuleId], references: [id])
  parent        Transaction?          @relation("TransactionInstallments", fields: [parentId], references: [id])
  installments  Transaction[]         @relation("TransactionInstallments")
  reimbursementOf Transaction?       @relation("TransactionReimbursement", fields: [reimbursementOfId], references: [id], onDelete: SetNull)
  reimbursements Transaction[]        @relation("TransactionReimbursement")
  reimbursementExpenses ReimbursementExpense[] @relation("ReimbursementSource")
  reimbursedExpenses ReimbursementExpense[] @relation("ReimbursementExpense")
  statement     CreditCardStatement?  @relation(fields: [statementId], references: [id])
  goalAllocations GoalAllocation[]

  @@index([transactionDate])
  @@index([accountId])
  @@index([statementId])
  @@index([reimbursementOfId])
}

model ReimbursementExpense {
  id             String      @id @default(uuid())
  reimbursementId String
  expenseId      String
  createdAt      DateTime    @default(now())

  reimbursement Transaction @relation("ReimbursementSource", fields: [reimbursementId], references: [id], onDelete: Cascade)
  expense       Transaction @relation("ReimbursementExpense", fields: [expenseId], references: [id], onDelete: Cascade)

  @@unique([reimbursementId, expenseId])
  @@index([reimbursementId])
  @@index([expenseId])
}

model Goal {
  id           String    @id @default(uuid())
  userId       String?
  name         String
  targetAmount Decimal   @db.Decimal(12, 2)
  targetDate   DateTime? @db.Date
  priority     Int       @default(1)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())

  allocations GoalAllocation[]
  links       GoalLink[]
  user        User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GoalLink {
  id        String   @id @default(uuid())
  goalId    String
  title     String?
  url       String
  context   String?
  createdAt DateTime @default(now())

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
}

model GoalAllocation {
  id            String   @id @default(uuid())
  goalId        String
  transactionId String?
  amount        Decimal  @db.Decimal(12, 2)
  allocatedAt   DateTime @default(now())

  goal        Goal         @relation(fields: [goalId], references: [id])
  transaction Transaction? @relation(fields: [transactionId], references: [id])
}

model InvestmentAccount {
  id           String       @id @default(uuid())
  userId       String?
  externalId   String?      @unique
  name         String
  legalContext LegalContext
  createdAt    DateTime     @default(now())

  holdings     InvestmentHolding[]
  transactions InvestmentTransaction[]
  user         User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InvestmentHolding {
  id          String  @id @default(uuid())
  accountId   String
  assetSymbol String
  assetName   String
  quantity    Decimal @db.Decimal(18, 6)
  avgPrice    Decimal @db.Decimal(12, 2)
  currentValue Decimal? @db.Decimal(14, 2)
  assetClass  String?

  account InvestmentAccount @relation(fields: [accountId], references: [id])

  @@unique([accountId, assetSymbol])
}

model InvestmentTransaction {
  id          String                    @id @default(uuid())
  accountId   String
  type        InvestmentTransactionType
  assetSymbol String
  assetName   String
  quantity    Decimal                   @db.Decimal(18, 6)
  unitPrice   Decimal                   @db.Decimal(12, 2)
  totalAmount Decimal                   @db.Decimal(12, 2)
  occurredAt  DateTime                  @db.Date
  createdAt   DateTime                  @default(now())

  account InvestmentAccount @relation(fields: [accountId], references: [id])
}
