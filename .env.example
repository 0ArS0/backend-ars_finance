# Porta em que a API NestJS será executada.
PORT=3003
# Origens extras permitidas pelo CORS (localhost e 127.0.0.1 já são aceitos em qualquer porta).
FRONTEND_URL=https://frontend-ars-finance.vercel.app
# Usuário do PostgreSQL local gerenciado pelo Docker Compose.
POSTGRES_USER=finance
# Senha do PostgreSQL local gerenciado pelo Docker Compose.
POSTGRES_PASSWORD=postgres
# Banco do PostgreSQL local gerenciado pelo Docker Compose.
POSTGRES_DB=finance_dashboard
# Porta local publicada pelo Docker Compose.
POSTGRES_PORT=5432
# URL de conexão com o PostgreSQL local.
DATABASE_URL=postgresql://finance:postgres@localhost:5432/finance_dashboard
# Identificador da aplicação na Pluggy.
CLIENT_ID=your_pluggy_client_id
# Chave secreta da aplicação na Pluggy.
CLIENT_SECRET=your_pluggy_client_secret
