# Porta em que a API NestJS será executada.
PORT=3003
# URLs permitidas pelo CORS, separadas por vírgula.
FRONTEND_URL=http://localhost:3001,https://frontend-ars-finance.vercel.app
# URL de conexão com o banco PostgreSQL do Supabase.
DATABASE_URL=postgresql://postgres:SUA_SENHA@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require
# Identificador da aplicação na Pluggy.
CLIENT_ID=your_pluggy_client_id
# Chave secreta da aplicação na Pluggy.
CLIENT_SECRET=your_pluggy_client_secret
